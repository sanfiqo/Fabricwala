# Copy to .env (git-ignored) and replace every value. Used by docker-compose.yml only.
MYSQL_ROOT_PASSWORD=change-me-to-a-long-random-text
# two different random texts of at least 32 characters each
LOOKUP_HMAC_KEY=change-me-lookup-key-at-least-32-characters
OTP_HMAC_KEY=change-me-otp-key-at-least-32-characters-different
FRONTEND_ORIGIN=http://localhost:5173
