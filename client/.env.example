# Backend URL the Vite dev proxy forwards /api to
VITE_API_PROXY_TARGET=http://localhost:5000
# true = no backend needed, sample data in memory
VITE_USE_MOCKS=true

# Per area switch (advanced). Areas: auth business catalog cart orders seller payouts notifications account admin
# VITE_REAL_AREAS=catalog,cart     use the real API for these even in demo mode
# VITE_MOCK_AREAS=payouts          use sample data for these even against the real API
