<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>TextileConnect.Api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <!-- Pulled in by Microsoft.AspNetCore.DataProtection at 10.0.9, which has high severity advisories. Remove these two lines once DataProtection ships a fixed dependency. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.15" NoWarn="NU1510" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="11.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sanfiqo.Identity\Sanfiqo.Identity.csproj" />
    <ProjectReference Include="..\TextileConnect.Application\TextileConnect.Application.csproj" />
    <ProjectReference Include="..\TextileConnect.Infrastructure\TextileConnect.Infrastructure.csproj" />
  </ItemGroup>

</Project>
